{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reed–Solomon visual example, version 1",
  "type": "object",
  "required": ["schemaVersion", "id", "field", "evaluationDomain", "coefficients", "codeword", "received", "radius", "expectedListSize", "provenance"],
  "$defs": {
    "element": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "word": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/element" } }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "description": { "type": "string" },
    "field": {
      "type": "object",
      "required": ["kind", "modulus"],
      "properties": { "kind": { "const": "prime" }, "modulus": { "$ref": "#/$defs/element" } },
      "additionalProperties": false
    },
    "evaluationDomain": { "$ref": "#/$defs/word", "uniqueItems": true },
    "coefficients": { "$ref": "#/$defs/word" },
    "codeword": { "$ref": "#/$defs/word" },
    "alternativeCoefficients": { "$ref": "#/$defs/word" },
    "alternativeCodeword": { "$ref": "#/$defs/word" },
    "received": { "$ref": "#/$defs/word" },
    "radius": { "type": "integer", "minimum": 0 },
    "expectedListSize": { "type": "integer", "minimum": 0 },
    "provenance": {
      "type": "object",
      "required": ["method", "formallyVerified"],
      "properties": { "method": { "type": "string" }, "formallyVerified": { "type": "boolean" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
